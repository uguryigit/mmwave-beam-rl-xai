# Copy this file to `.env` and fill in real values; `.env` is git-ignored.
# Or export these as shell environment variables before running the apps.

# --- AWS (S3 + Bedrock) ---
# Used by streamlit_app4.py (S3 polling) and LLM/pinecone/index_docx_pinecone.py
# (Bedrock Titan embeddings). Prefer an IAM role on EC2/ECS over long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=dqn-simulation

# --- Pinecone (vector DB for the RAG / Vector-AI agent) ---
PINECONE_API_KEY=

# --- Supabase / Postgres (SQL-AI agent log store) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- n8n explainability webhook ---
N8N_WEBHOOK_URL=https://n8n.howlet.io/webhook/streamlit
